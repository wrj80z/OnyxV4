local calcposka = {}
local cloneref = cloneref or function(obj: any) return obj end
local RunService = cloneref(game:GetService("RunService"))
local Stats = cloneref(game:GetService("Stats"))
local playersService = cloneref(game:GetService('Players'))
local lplr = playersService.LocalPlayer
local stop = false
local trackers = {}
vape:Clean(function()
    stop = true
end)
task.spawn(function()
    while task.wait(30) do
        if stop then break end
        local currentTime = tick()
        for target, data in pairs(trackers) do
            if not target.Parent or currentTime - data.lastUpdate > 5 then
                trackers[target] = nil
            end
        end
    end
end)

local function getTrackerData(targetRoot, sampleCount)
    local data = trackers[targetRoot]
    
    if not data then
        data = {
            positions = {},
            times = {},
            velocities = {},
            smoothVelocity = Vector3.zero,
            acceleration = Vector3.zero,
            lastPosition = targetRoot.Position,
            lastTime = tick(),
            lastUpdate = tick(),
        }
        trackers[targetRoot] = data
    end
    
    local now = tick()
    local dt = now - data.lastTime
    
    if dt <= 0 or dt > 0.2 then
        data.lastPosition = targetRoot.Position
        data.lastTime = now
        data.lastUpdate = now
        return data.smoothVelocity, data.acceleration
    end
    
    local instantVelocity = (targetRoot.Position - data.lastPosition) / dt
    
    table.insert(data.positions, targetRoot.Position)
    table.insert(data.times, now)
    
    if #data.positions > sampleCount + 1 then
        table.remove(data.positions, 1)
        table.remove(data.times, 1)
    end
    
    table.insert(data.velocities, instantVelocity)
    if #data.velocities > sampleCount then
        table.remove(data.velocities, 1)
    end
    
    if #data.velocities >= 2 then
        local weightedVel = Vector3.zero
        local totalWeight = 0
        
        for i, vel in ipairs(data.velocities) do
            local weight = math.exp(0.5 * (i - #data.velocities))
            weightedVel = weightedVel + vel * weight
            totalWeight = totalWeight + weight
        end
        
        data.smoothVelocity = weightedVel / totalWeight
        
        local speed = data.smoothVelocity.Magnitude
        if speed < 1 then
            data.smoothVelocity = data.smoothVelocity * (speed / 1)
        end
    else
        data.smoothVelocity = instantVelocity
    end
    
    if #data.positions >= 3 then
        local n = #data.positions
        local dt1 = data.times[n-1] - data.times[n-2]
        local dt2 = data.times[n] - data.times[n-1]
        
        if dt1 > 0 and dt2 > 0 then
            local vel1 = (data.positions[n-1] - data.positions[n-2]) / dt1
            local vel2 = (data.positions[n] - data.positions[n-1]) / dt2
            local avgDt = (dt1 + dt2) / 2
            
            local rawAccel = (vel2 - vel1) / avgDt
            
            data.acceleration = data.acceleration * 0.7 + rawAccel * 0.3
            
            local accelMag = data.acceleration.Magnitude
            if accelMag > 500 then
                data.acceleration = data.acceleration.Unit * 500
            end
        end
    end
    
    data.lastPosition = targetRoot.Position
    data.lastTime = now
    data.lastUpdate = now
    
    return data.smoothVelocity, data.acceleration
end

function calcposka.calcPos(myPos, targetRoot)    
    if not myPos or not targetRoot or not targetRoot.Parent then
        return myPos or Vector3.zero
    end
    
    local config = {
        projectileSpeed = 250,
        maxPredictionTime = 1 + lplr:GetNetworkPing() * math.random(5,10),
        velocitySamples =  8,
        useAcceleration = true,
        useGravity = true,
        gravity = workspace.Gravity,
        horizontalOnly = false,
        pingBuffer = lplr:GetNetworkPing() * 10,
        minSpeedThreshold = 0.5,
    }
    
    local rawPingMs = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    local scndpingms = lplr:GetNetworkPing()
    local oneWayPing = (rawPingMs / 1000) * 0.5 + config.pingBuffer + scndpingms
    
    local velocity, acceleration = getTrackerData(targetRoot, config.velocitySamples)
    
    local predictionVelocity = velocity
    if config.horizontalOnly then
        predictionVelocity = Vector3.new(velocity.X, 0, velocity.Z)
    end
    
    local displacement = targetRoot.Position - myPos
    local distance = displacement.Magnitude
    
    local travelTime = 0
    if config.projectileSpeed < math.huge and config.projectileSpeed > 0 then
        travelTime = distance / config.projectileSpeed
    end
    
    local predictionTime = math.clamp(oneWayPing + travelTime, 0, config.maxPredictionTime)
    
    local predictedPos = targetRoot.Position + (predictionVelocity * predictionTime)
    
    if config.useAcceleration then
        local speed = predictionVelocity.Magnitude
        if speed >= config.minSpeedThreshold then
            predictedPos = predictedPos + (acceleration * 0.5 * predictionTime * predictionTime)
        end
    end
    
    if config.useGravity then
        local yVel = velocity.Y
        local gravityOffset = yVel * predictionTime - (0.5 * config.gravity * predictionTime * predictionTime)
        predictedPos = predictedPos + Vector3.new(0, gravityOffset, 0)
    end
    
    return predictedPos
end

return calcposka
